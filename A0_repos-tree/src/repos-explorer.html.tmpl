<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark">
<title>Repos</title>
<style>
:root{color-scheme:dark;--bg:#0f1318;--card:#171d25;--card2:#1d2530;--line:#2a3441;--text:#e6edf3;--dim:#8b98a8;--acc:#4da3ff;--accb:#16385f;--pub:#3fb950;--priv:#f85149;--hub:#bc8cff;--warn:#d29922}
*{box-sizing:border-box}html,body{height:100%;margin:0}
body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:13px/1.35 system-ui,"Segoe UI",Roboto,sans-serif}
header{padding:8px 10px 6px;border-bottom:1px solid var(--line);background:var(--card)}
.top{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
h1{font-size:16px;margin:0 6px 0 0;font-weight:600}
.chips{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.chip{border:1px solid var(--line);background:var(--card2);color:var(--text);border-radius:16px;padding:3px 11px;font:inherit;cursor:pointer;white-space:nowrap}
.chip.on{background:var(--accb);border-color:var(--acc);color:var(--acc);font-weight:600}
.chip.sm{padding:1px 8px;font-size:11px}
.sep{color:var(--dim);margin:0 2px}
input[type=search]{flex:1;min-width:140px;background:var(--card2);border:1px solid var(--line);border-radius:16px;padding:4px 12px;color:var(--text);font:inherit}
.sub{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-top:6px;color:var(--dim);font-size:12px}
#count{margin-left:auto}
main{flex:1;min-height:0;display:flex}
#view{flex:1;min-width:0;overflow:auto;position:relative}
#detail{width:320px;max-width:42vw;border-left:1px solid var(--line);background:var(--card);overflow:auto;padding:8px 10px;display:none}
#detail.on{display:block}
#detail h2{font-size:14px;margin:0 0 6px;word-break:break-all}
#detail dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:3px 10px}#detail dt{color:var(--dim)}#detail dd{margin:0;word-break:break-word}
.row{display:flex;align-items:center;gap:8px;padding:6px 10px;border-bottom:1px solid var(--line);cursor:pointer}
.row:hover,.row.sel{background:var(--card2)}.row.sel{box-shadow:inset 3px 0 var(--acc)}
.row .tg{width:16px;text-align:center;color:var(--dim);flex:none;user-select:none}
.row .nm{font-weight:600;white-space:nowrap}.row .b{white-space:nowrap}.row .cd{color:var(--dim);font-family:ui-monospace,Menlo,monospace;font-size:11px}
.row .ds{color:var(--dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
.b{display:inline-block;border-radius:10px;padding:0 7px;font-size:11px;border:1px solid var(--line);color:var(--dim)}
.b.public{color:var(--pub);border-color:var(--pub)}.b.private{color:var(--priv);border-color:var(--priv)}.b.hub{color:var(--hub);border-color:var(--hub)}
.card{margin:8px 10px;background:var(--card);border:1px solid var(--line);border-radius:10px}
table{border-collapse:collapse;width:max-content;min-width:100%}
th,td{padding:4px 9px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap;max-width:360px;overflow:hidden;text-overflow:ellipsis}
th{position:sticky;top:0;background:var(--card2);cursor:pointer;user-select:none;z-index:2;font-weight:600}
th.on{color:var(--acc)}
td:first-child,th:first-child{position:sticky;left:0;background:var(--card2);z-index:1}
tr.sel td{background:var(--accb)}tbody tr:hover td{background:var(--card2)}
a{color:var(--acc);text-decoration:none}
svg#cv{width:100%;height:100%;display:block;touch-action:none;cursor:grab}
.cvbar{position:absolute;right:10px;top:8px;display:flex;gap:6px;z-index:3}
.legend{position:absolute;left:10px;bottom:8px;color:var(--dim);font-size:11px;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:3px 8px}
.n rect{fill:var(--card);stroke:var(--line);stroke-width:1.2}.n.public rect{stroke:var(--pub)}.n.private rect{stroke:var(--priv)}.n.hub rect{fill:var(--card2);stroke:var(--hub)}.n.sel rect{stroke:var(--acc);stroke-width:2.5}
.n text{fill:var(--text);font-size:11px;pointer-events:none}.n text.c{fill:var(--dim);font-size:9px}
.e{fill:none;stroke:var(--dim);stroke-width:1.1;opacity:.55}
.empty{padding:24px;color:var(--dim)}
</style></head><body>
<header>
<div class="top"><h1>Repos</h1>
<div class="chips" id="modes"><button class="chip" data-m="list">List</button><button class="chip" data-m="table">Table</button><button class="chip" data-m="canvas">Canvas</button><span class="sep">|</span><a class="chip" href="repos-tree.html" id="oldtree">Tree</a></div>
<input type="search" id="q" placeholder="Search every field (name, code, project, language, topic, ...)" aria-label="search"></div>
<div class="sub"><span>visibility</span><span class="chips" id="fv"></span><span>kind</span><span class="chips" id="fk"></span><span>role</span><span class="chips" id="fr"></span><span id="count"></span></div>
</header>
<main><div id="view"></div><aside id="detail"></aside></main>
<script>
var J=/*DATA*/null,R=J.rows,BY={};R.forEach(function(r){BY[r.name]=r});
var $=function(i){return document.getElementById(i)},esc=function(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})};
var st={mode:"list",q:"",vis:"",kind:"",role:"",sk:"",sd:1,sel:"",col:{}};
var m0=/mode=(list|table|canvas)/.exec(location.hash);if(m0)st.mode=m0[1];
// columns = every key of the rows (nested objects flattened as parent.child), in row order: no registry field is left out
function flat(r){var o={};Object.keys(r).forEach(function(k){var v=r[k];if(v&&typeof v==="object"&&!Array.isArray(v)){Object.keys(v).forEach(function(k2){o[k+"."+k2]=v[k2]})}else o[k]=v});return o}
var F=R.map(flat),COLS=[];F.forEach(function(o){Object.keys(o).forEach(function(k){if(COLS.indexOf(k)<0)COLS.push(k)})});COLS.splice(COLS.indexOf("name"),1);COLS.unshift("name");   // the name column leads (sticky)

var NUM={};COLS.forEach(function(k){NUM[k]=F.every(function(o){var v=o[k];return v===""||v==null||typeof v==="number"})&&F.some(function(o){return typeof o[k]==="number"})});
function cell(v){if(v==null)return"";if(Array.isArray(v))return v.join(", ");if(typeof v==="boolean")return v?"yes":"no";return String(v)}
function hay(i){var o=F[i];return COLS.map(function(k){return cell(o[k])}).join("\u0001").toLowerCase()}
var H=R.map(function(_,i){return hay(i)});
function vals(f){var s={};R.forEach(function(r){var v=f(r);if(v!=="")s[v]=(s[v]||0)+1});return Object.keys(s).sort()}
function chips(id,key,list){var h='<button class="chip sm'+(st[key]===""?" on":"")+'" data-k="'+key+'" data-v="">all</button>';list.forEach(function(v){h+='<button class="chip sm'+(st[key]===v?" on":"")+'" data-k="'+key+'" data-v="'+esc(v)+'">'+esc(v)+"</button>"});$(id).innerHTML=h}
function pass(i){var r=R[i];if(st.vis&&r.visibility!==st.vis)return false;if(st.kind&&r.kind!==st.kind)return false;if(st.role&&(r.role||(r.node==="hub"?"hub":""))!==st.role)return false;if(st.q&&H[i].indexOf(st.q)<0)return false;return true}
function vis(){var a=[];R.forEach(function(_,i){if(pass(i))a.push(i)});return a}
var collapsed={};
function hidden(r){for(var p=r.parent;p;p=BY[p]&&BY[p].parent){if(collapsed[p])return true}return false}
function listHtml(){var h="",n=0,filt=!!(st.q||st.vis||st.kind||st.role);R.forEach(function(r,i){if(!pass(i))return;if(!filt&&hidden(r))return;n++;
 var has=r.children_count>0,tg=has&&!filt?(collapsed[r.name]?"▸":"▾"):"·";
 h+='<div class="row'+(st.sel===r.name?" sel":"")+'" data-n="'+esc(r.name)+'" style="padding-left:'+(10+(filt?0:r.depth)*20)+'px"><span class="tg" data-t="'+esc(r.name)+'">'+tg+'</span><span class="nm">'+esc(r.name)+'</span><span class="cd">'+esc(r.code)+'</span><span class="b '+esc(r.visibility)+'">'+esc(r.visibility)+"</span>"+(r.node==="hub"?'<span class="b hub">hub</span>':"")+(r.role&&r.role!=="hub"?'<span class="b">'+esc(r.role)+"</span>":"")+(r.gh&&r.gh.language?'<span class="b">'+esc(r.gh.language)+"</span>":"")+(has?'<span class="b">'+r.children_count+" child"+(r.children_count>1?"ren":"")+"</span>":"")+'<span class="ds">'+esc(r.description||(r.gh&&r.gh.description)||"")+"</span></div>"});
 if(!n)return'<div class="empty">no repo matches</div>';
 if(!filt&&J.groups&&J.groups.length)h+='<div class="card"><div class="row" style="cursor:default"><b>Folder groups ('+J.groups.length+')</b></div>'+J.groups.map(function(g){return'<div class="row" style="cursor:default"><span class="cd">'+esc(g.path)+'</span><span class="ds">'+esc(g.doc||"")+'</span><span class="b">in '+esc(g.parent)+'</span></div>'}).join("")+"</div>";
 return h}
function tableHtml(){var ix=vis();if(st.sk){var k=st.sk,nu=NUM[k];ix.sort(function(a,b){var x=F[a][k],y=F[b][k];x=x==null?"":x;y=y==null?"":y;var c=nu?((x===""?-Infinity:x)-(y===""?-Infinity:y)):cell(x).localeCompare(cell(y),undefined,{numeric:true});return c*st.sd||a-b})}
 var h="<table><thead><tr>"+COLS.map(function(k){return'<th data-c="'+esc(k)+'"'+(st.sk===k?' class="on"':"")+">"+esc(k)+(st.sk===k?(st.sd>0?" ▲":" ▼"):"")+"</th>"}).join("")+"</tr></thead><tbody>";
 ix.forEach(function(i){var o=F[i];h+='<tr data-n="'+esc(R[i].name)+'"'+(st.sel===R[i].name?' class="sel"':"")+">"+COLS.map(function(k){var v=cell(o[k]);return"<td"+(NUM[k]?' style="text-align:right"':"")+' title="'+esc(v)+'">'+(k==="url"||k==="gh.html_url"?'<a href="'+esc(v)+'">'+esc(v)+"</a>":esc(v))+"</td>"}).join("")+"</tr>"});
 return h+"</tbody></table>"+(ix.length?"":'<div class="empty">no repo matches</div>')}
// canvas: parent/child graph, tidy layered layout (x = depth, y = leaf order), pan + zoom
var cv={x:20,y:20,k:1};
function canvasHtml(){var ix=vis(),set={};ix.forEach(function(i){set[R[i].name]=1});var pos={},y=0,W=210,Hh=34;
 ix.forEach(function(i){var r=R[i];pos[r.name]={x:r.depth*(W+40),y:y++*Hh}});
 var e="",n="";ix.forEach(function(i){var r=R[i],p=pos[r.name],q=r.parent&&pos[r.parent];if(q){e+='<path class="e" d="M'+(q.x+W)+","+(q.y+13)+" C"+(q.x+W+20)+","+(q.y+13)+" "+(p.x-20)+","+(p.y+13)+" "+p.x+","+(p.y+13)+'"/>'}
 n+='<g class="n '+esc(r.visibility)+(r.node==="hub"?" hub":"")+(st.sel===r.name?" sel":"")+'" data-n="'+esc(r.name)+'" transform="translate('+p.x+","+p.y+')" style="cursor:pointer"><rect width="'+W+'" height="26" rx="8"/><text x="8" y="12">'+esc(r.name.length>30?r.name.slice(0,29)+"…":r.name)+'</text><text class="c" x="8" y="22">'+esc(r.code)+" · "+esc(r.visibility)+(r.children_count?" · "+r.children_count+" child":"")+"</text></g>"});
 return'<div class="cvbar"><button class="chip sm" data-z="1.2">+</button><button class="chip sm" data-z="0.83">-</button><button class="chip sm" data-z="0">fit</button></div><svg id="cv" role="img" aria-label="repos canvas" xmlns="http://www.w3.org/2000/svg"><g id="vp" transform="translate('+cv.x+","+cv.y+") scale("+cv.k+')">'+e+n+'</g></svg><div class="legend">green = public, red = private, purple = hub; click a node for every field; drag to pan, wheel to zoom</div>'}
function detail(){var d=$("detail");if(!st.sel||!BY[st.sel]){d.className="";d.innerHTML="";return}var o=F[R.indexOf(BY[st.sel])];d.className="on";
 d.innerHTML='<h2>'+esc(st.sel)+' <a href="#" data-x="1" style="float:right">×</a></h2><dl>'+COLS.map(function(k){var v=cell(o[k]);return v===""?"":"<dt>"+esc(k)+"</dt><dd>"+((k==="url"||k==="gh.html_url")?'<a href="'+esc(v)+'">'+esc(v)+"</a>":esc(v))+"</dd>"}).join("")+"</dl>"}
function draw(){document.querySelectorAll("[data-m]").forEach(function(b){b.classList.toggle("on",b.dataset.m===st.mode)});
 chips("fv","vis",vals(function(r){return r.visibility}));chips("fk","kind",vals(function(r){return r.kind}));chips("fr","role",vals(function(r){return r.role||(r.node==="hub"?"hub":"")}));
 var v=$("view"),sc=v.scrollTop,sl=v.scrollLeft;v.innerHTML=st.mode==="list"?listHtml():st.mode==="table"?tableHtml():canvasHtml();v.scrollTop=sc;v.scrollLeft=sl;
 $("count").textContent=vis().length+" of "+R.length+" repos · "+COLS.length+" fields";detail();if(st.mode==="canvas")fit(false)}
function fit(force){var s=$("cv");if(!s)return;var vp=$("vp"),b=vp.getBBox(),w=s.clientWidth,h=s.clientHeight;if(force||!st.fitted){cv.k=Math.min(1,Math.max(.45,(w-40)/(b.width||1)));cv.x=20;cv.y=20;st.fitted=1}vp.setAttribute("transform","translate("+cv.x+","+cv.y+") scale("+cv.k+")")}
document.addEventListener("click",function(ev){var t=ev.target,b;
 if((b=t.closest("[data-m]"))){st.mode=b.dataset.m;st.fitted=0;draw();return}
 if((b=t.closest("[data-k]"))){st[b.dataset.k]=b.dataset.v;draw();return}
 if((b=t.closest("[data-z]"))){var z=+b.dataset.z;if(!z)fit(true);else{cv.k=Math.max(.1,Math.min(4,cv.k*z));$("vp").setAttribute("transform","translate("+cv.x+","+cv.y+") scale("+cv.k+")")}return}
 if((b=t.closest("[data-x]"))){ev.preventDefault();st.sel="";draw();return}
 if((b=t.closest("[data-t]"))&&!st.q){collapsed[b.dataset.t]=!collapsed[b.dataset.t];draw();ev.stopPropagation();return}
 if((b=t.closest("th[data-c]"))){var k=b.dataset.c;if(st.sk===k){if(st.sd>0)st.sd=-1;else{st.sk="";st.sd=1}}else{st.sk=k;st.sd=1}draw();return}
 if(t.closest("a"))return;
 if((b=t.closest("[data-n]"))){st.sel=b.dataset.n;draw()}});
$("q").addEventListener("input",function(e){st.q=e.target.value.trim().toLowerCase();draw()});
var drag=null;document.addEventListener("pointerdown",function(e){if(st.mode==="canvas"&&e.target.closest("#cv")&&!e.target.closest(".n")){drag={x:e.clientX,y:e.clientY,ox:cv.x,oy:cv.y}}});
document.addEventListener("pointermove",function(e){if(drag){cv.x=drag.ox+e.clientX-drag.x;cv.y=drag.oy+e.clientY-drag.y;$("vp").setAttribute("transform","translate("+cv.x+","+cv.y+") scale("+cv.k+")")}});
document.addEventListener("pointerup",function(){drag=null});
document.addEventListener("wheel",function(e){if(st.mode==="canvas"&&e.target.closest("#cv")){e.preventDefault();cv.k=Math.max(.1,Math.min(4,cv.k*(e.deltaY<0?1.1:.9)));$("vp").setAttribute("transform","translate("+cv.x+","+cv.y+") scale("+cv.k+")")}},{passive:false});
draw();
</script></body></html>
