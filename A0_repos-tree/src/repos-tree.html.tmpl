 else if(view==="tree"&&k==="ArrowRight"&&n&&n.hub){if(!open[n.id]){open[n.id]=true;render()}else move(i+1)}
 else if(view==="tree"&&k==="ArrowLeft"&&n){if(n.hub&&open[n.id]){open[n.id]=false;render()}else if(n.parent&&n.parent!==cur){sel=n.parent;render()}}
 else if(k==="Home"){move(0)}else if(k==="End"){move(items.length-1)}else return;
 e.preventDefault()});
