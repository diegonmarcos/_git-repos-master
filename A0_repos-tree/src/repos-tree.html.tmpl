document.addEventListener("keydown",function(e){
 if(e.target===$("q")||mode!=="list")return;var i=idx(),n=sel?by[sel]:null,k=e.key;
 if(e.altKey&&k==="ArrowLeft"){hist_(-1)}else if(e.altKey&&k==="ArrowRight"){hist_(1)}else if(e.altKey&&k==="ArrowUp"){$("upb").click()}
 else if(e.ctrlKey&&"123".indexOf(k)>=0&&k){view=["icons","details","tree"][+k-1];render()}
 else if((e.ctrlKey&&k==="f")||k==="/"){e.preventDefault();$("q").focus();$("q").select()}
