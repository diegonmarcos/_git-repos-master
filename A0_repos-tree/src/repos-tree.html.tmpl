$("view").addEventListener("click",function(e){var t=e.target.closest("[data-t]");if(t){open[t.dataset.t]=!open[t.dataset.t];render();return}
 var tt=e.target.closest("th[data-tk]");if(tt){var k2=tt.dataset.tk;tsD=tsK===k2?-tsD:1;tsK=k2;render();return}
 var th=e.target.closest("th");if(th&&th.dataset.k){var k=th.dataset.k;sortD=sortK===k?-sortD:1;sortK=k;render();return}
 var r=e.target.closest("[data-i]");if(r){sel=items[+r.dataset.i].n.id;render()}});
